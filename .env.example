# 雪球爬虫环境变量配置
# 复制此文件为 .env 并填入实际值

# ── AI 分析凭证 ────────────────────────────────────────────────
# 当前生产用的是「字节方舟 coding plan」（provider=minimax），主要看 ARK_API_KEY
ARK_API_KEY=your_ark_api_key_here
# 方舟 coding plan 网关地址（可选，不填则用代码里的默认值）
ARK_CODING_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3

# 备用 provider（百炼 / MiniMax）
BAILIAN_API_KEY=your_bailian_api_key_here
MINIMAX_API_KEY=your_minimax_api_key_here

# provider 选择：minimax（默认，走方舟 coding plan）/ aliyun（百炼）
# ANALYZER_PROVIDER=minimax

# 注意：**模型 id 不在这里配**。唯一来源是 config/config.yaml 的
# analysis.models.<provider>，analyzer 与 push_feishu 同源读取
# （见 scripts/llm_config.py 与 PROJECT_LOG D-009）。
# 曾有一个 ANALYZE_LLM_MODEL 覆盖，已移除——不入库的第二来源会让服务器上
# 残留的旧值静默压过仓库配置，模型悄悄退回旧版且没人发现。

# ── 飞书推送 ───────────────────────────────────────────────────
FEISHU_WEBHOOK=your_feishu_webhook_url_here

# ── 雪球登录（scripts/login.py 用） ────────────────────────────
XUEQIU_USERNAME=your_xueqiu_username_here
XUEQIU_PASSWORD=your_xueqiu_password_here

# IMA 知识库推送凭证（腾讯 IMA OpenAPI）
IMA_OPENAPI_CLIENTID=your_ima_client_id_here
IMA_OPENAPI_APIKEY=your_ima_api_key_here

# GitHub Token（可选，用于 Gist 同步）
GITHUB_TOKEN=your_github_token_here
